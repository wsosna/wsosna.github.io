---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import photo from '../assets/photo.jpg';

const links = [
	{ label: 'GitHub', href: 'https://github.com/wsosna' },
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/weronika-sosnowska-60b421150/' },
];
---

<Base
	title="Weronika Sosnowska"
	description="Senior Software Engineer at Seqera. Personal page."
>
	<main>
		<header class="hero">
			<h1>Weronika Sosnowska<span class="caret" aria-hidden="true"></span></h1>
			<p class="role">Senior Software Engineer at Seqera</p>
		</header>

		<section id="about">
			<h2><span class="comment">// </span>about</h2>
			<div class="about">
				<Image
					class="photo"
					src={photo}
					alt="Weronika cycling on a coastal road, seen from behind"
					width={288}
					height={288}
					densities={[1, 2]}
				/>
				<div class="bio">
					<p>
						I work on how cloud sessions connect and how they save their state:
						tunnels and access control in Go on one side, copy-on-write
						filesystems on the other.
					</p>
					<p>
						I like a challenge, so I keep finding new things to be a beginner at.
						Right now it's robotics and applied AI, learned mostly by trying to
						solder without burning myself.
					</p>
					<p>Welcome to my corner of the internet.</p>
				</div>
			</div>
			<ul class="links">
				{
					links.map((link) => (
						<li>
							<a href={link.href} target="_blank" rel="noopener noreferrer">
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</main>
</Base>

<style>
	.hero {
		margin-bottom: 4rem;
	}

	h1 {
		margin: 0;
		font-size: clamp(2rem, 6vw, 3rem);
	}

	.caret {
		display: inline-block;
		width: 0.55em;
		height: 1em;
		margin-left: 0.15em;
		vertical-align: text-bottom;
		background: var(--accent);
		animation: blink 1.1s steps(1) infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.caret {
			animation: none;
		}
	}

	.role {
		margin: 0.75rem 0 0;
		font-family: var(--font-mono);
		color: var(--string);
	}

	h2 {
		font-size: 1.25rem;
		margin: 0 0 1.5rem;
	}

	.comment {
		color: var(--comment);
	}

	.about {
		display: flex;
		gap: 2rem;
		align-items: flex-start;
	}

	.about :global(.photo) {
		flex: none;
		width: 9rem;
		height: 9rem;
		object-fit: cover;
		border-radius: 0.5rem;
		background: var(--surface);
	}

	.bio p {
		margin: 0 0 1rem;
	}

	.links {
		display: flex;
		gap: 1.5rem;
		margin: 2rem 0 0;
		padding: 0;
		list-style: none;
		font-family: var(--font-mono);
	}

	@media (max-width: 36rem) {
		.about {
			flex-direction: column;
		}
	}
</style>
